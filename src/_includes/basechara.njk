---
layout: 'base.njk'
---

      <div class="characterprofile">
    <div class="charactermain-image" style="background-image: url('/assets/thumbs/cast/{{ title | lower | slugify }}.png')" alt="A thumbnail of {{ title }}"></div>
      <table>

  <tr>
    <th>Pronouns</th>
    <td>{{ pronouns }}</td>
  </tr>

  {% if (alias) %}
    <tr>
    <th>Nom de Plume</th>
    <td>{{ alias }}</td>
  </tr>
  {% endif %}

  <tr>
    <th>Species</th>
    <td>{{ species }}</td>
  </tr>

    <tr>
    <th>Age</th>
    <td>{{ age }}</td>
  </tr>

    <tr>
    <th>Occupation</th>
    <td>{{ occupation }}</td>
  </tr>

    <tr>
    <th>Birthplace</th>
    <td>{{ birthplace }}</td>
  </tr>

    <tr>
    <th>Nicknames & Titles</th>
    <td>{{ nicknames }}</td>
  </tr>

  {% if (song) %}
    <tr>
    <th>Song(s)</th>
    <td><a target="_blank" href="{{ songlink }}"><i>{{ song }}</i></a>{% if (song2) %} / <a target="_blank" href="{{ songlink2 }}"><i>{{ song2 }}</i></a>{% endif %}{% if (song3) %} / <a target="_blank" href="{{ songlink3 }}"><i>{{ song3 }}</i></a>{% endif %}{% if (song4) %} / <a target="_blank" href="{{ songlink4 }}"><i>{{ song4 }}</i></a>{% endif %}{% if (song5) %} / <a target="_blank" href="{{ songlink5 }}"><i>{{ song5 }}</i></a>{% endif %}{% if (song6) %} / <a target="_blank" href="{{ songlink6 }}"><i>{{ song6 }}</i></a>{% endif %}{% if (song7) %} / <a target="_blank" href="{{ songlink7 }}"><i>{{ song7 }}</i></a>{% endif %}</td>
  </tr>
  {% endif %}

    {% if (homepage) %}
    <tr>
    <th>Homepage</th>
    <td><a href="{{ homepagelink }}">{{ homepage }}</a></td>
   </tr>
  {% endif %}
</table>
  </div>

<div id="toc"></div>

<div id="contents">

{{ content | safe }}

{% if relationships %}

  <div class="centerDivider">
  <img src="/assets/dividers/divider31.png" style="height:100%; width:100%; margin-top:20px;" alt="Divider" aria-hidden="true">
  </div>

<div class="box4boxes" style="max-height:50em;">
<h2>Relationships</h2>

<small div class="center">(Click on a name or headshot to be taken to a profile, if it exists.)</small>

{%- for relationships in relationships -%}

<div class="relationshipbox">
<a href="/cast/{{ relationships.name | slugify }}"><img src="/assets/thumbs/cast/{{ relationships.name }}.png" alt="A thumbnail of {{ relationships.name }}." div class="relationshipimg" onerror="this.onerror=null; this.src='/assets/thumbs/cast/unknown.png';"></a>
<h3><a href="/cast/{{ relationships.name | slugify }}"> {{ relationships.name }}</a> - {% if relationships.rating == 0 %}☆☆☆☆☆{% endif %}{% if relationships.rating == 1 %}★☆☆☆☆{% endif %}{% if relationships.rating == 2 %}★★☆☆☆{% endif %}{% if relationships.rating == 3 %}★★★☆☆{% endif %}{% if relationships.rating == 4 %}★★★★☆{% endif %}{% if relationships.rating == 5 %}★★★★★{% endif %}{% if relationships.custom %}{{ relationships.custom }}{% endif %}</h3>
<dd><img src="/assets/decor/starred.gif" alt="A GIF of a small red star." aria-hidden="true"> <strong>Relationship: {{ relationships.label }}</strong></dd>
<hr>
<p>{{ relationships.desc | mdbr | safe }}</p>
</div>

{%- endfor -%}

{% if (mrelationships) %}

<details style="text-align:center;">
<summary><strong><em>View Minor Relationships?</em></strong></summary>
{%- for mrelationships in mrelationships -%}

<div class="relationshipbox" style="text-align:left;">
<a href="/cast/{{ mrelationships.name | slugify }}"><img src="/assets/thumbs/cast/{{ mrelationships.name | slugify }}.png" alt="A thumbnail of {{ mrelationships.name }}." div class="relationshipimg" onerror="this.onerror=null; this.src='/assets/thumbs/cast/unknown.png';"></a>
<h3><a href="/cast/{{ mrelationships.name | slugify }}"> {{ mrelationships.name }}</a> - {% if mrelationships.rating == 0 %}☆☆☆☆☆{% endif %}{% if mrelationships.rating == 1 %}★☆☆☆☆{% endif %}{% if mrelationships.rating == 2 %}★★☆☆☆{% endif %}{% if mrelationships.rating == 3 %}★★★☆☆{% endif %}{% if mrelationships.rating == 4 %}★★★★☆{% endif %}{% if mrelationships.rating == 5 %}★★★★★{% endif %}{% if mrelationships.custom %}{{ mrelationships.custom }}{% endif %}</h3>
<dd><img src="/assets/decor/swirlred.gif" alt="A GIF of a small red swirl." aria-hidden="true"> <strong>Relationship: {{ mrelationships.label }}</strong></dd>
<hr>
<p>{{ mrelationships.desc | mdbr | safe }}</p>
</div>

{%- endfor -%}
</details>
{% endif %}
</div>
{% endif %}

  <div class="centerDivider">
  <img src="/assets/dividers/divider31.png" style="height:100%; width:100%; margin-top:20px;" alt="Divider" aria-hidden="true">
  </div>

{% if notes %}

<div class="box4boxes" style="max-height:20em;">
<h2>Notes</h2>

<ul>
{%- for notes in notes -%}

<li>{{ notes | mdbr | safe }}</li>

{%- endfor %}
</ul>

<section>
{% include 'globalnotes.njk' %}
</section>

{% endif %}

</div>

{% if trivia %}

  <div class="centerDivider">
  <img src="/assets/dividers/divider31.png" style="height:100%; width:100%; margin-top:20px;" alt="Divider" aria-hidden="true">
  </div>

<div class="box4boxes">
<h2>Trivia</h2>
<img src="/assets/decor/characters/{{ title | slugify }}.png" div class="pagedollbreaker">

<ul>
{%- for trivia in trivia -%}

<li>{{ trivia | mdbr | safe }}</li>

{%- endfor -%}
</ul>

{% endif %}

</div>
</div>