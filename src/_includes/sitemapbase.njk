---
layout: 'base.njk'
---

<section>
    <h2>Main Pages!</h2>
    <ul>
      {% for mainpage in collections.mainpage %}
        <li><a href="/{{ mainpage.data.id }}">{{ mainpage.data.title }}</a></li>
      {% endfor %}
    </ul>
    </section>

  <section>
    <h2>Meet the Cast!</h2>
    <ul>
      {% for cast in collections.cast %}
        <li><a href="/cast/{{ cast.data.id | lower }}">{{ cast.data.title }}</a></li>
      {% endfor %}
      </ul>
      </section>

    <section>
    <h2>World Building!</h2>
    <ul>
      {% for world in collections.world %}
        <li><a href="/world/{{ world.data.id }}">{{ world.data.title }}</a></li>
      {% endfor %}
      </ul>
      </section>

  <section>
    <h2 style="margin-bottom:0;">Miscellaneous!</h2>
    <ul>
      {% for misc in collections.misc %}
        <li><a href="/misc/{{ misc.data.id | lower }}">{{ misc.data.title }}</a></li>
      {% endfor %}
    </ul>

        <h3 style="margin-top:.5em;">Oh, Yeah. The Other Stuff. <small>(Fun)</small></h3>
        <ul>
      {% for fun in collections.fun %}
        <li><a href="/misc/fun/{{ fun.data.id | lower }}">{{ fun.data.title }}</a></li>
      {% endfor %}
    </ul>

    <h3 style="margin-top:.5em;">Oh…  The <em>Other</em> Other Stuff… <small>(Shrines)</small></h3>
        <ul>
      {% for shrines in collections.shrines %}
        <li><a href="/misc/shrines/{{ shrines.data.id | lower }}">{{ shrines.data.title }}</a></li>
      {% endfor %}
    </ul>
</section>