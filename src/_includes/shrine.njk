tags:
- page
---

<!DOCTYPE html>
<html class="no-js" lang="{{ metadata.language }}">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{{ title | default('Surfer') }} Zone</title>
<link rel="stylesheet" href="{{ metadata.assets.css }}/shrine2.css">
<meta name="description" content="{{ metadata.assets.desc }}">
<link rel="icon" href="/assets/icons/{{ favicon }}" sizes="any">
<script src="{{ metadata.assets.js }}/snav.js" type="text/javascript" defer></script>
<script src="https://u.widget.st/ar.js"></script>

<meta name="author" content="{{ metadata.assets.author }}">
<meta name="keywords" content=" {{ metadata.assets.tags }}">
<meta name="description" content="{{ metadata.assets.desc }}">

<meta itemprop="description" content="{{ metadata.assets.desc }}">
<meta itemprop="image" content="{{ metadata.assets.linkbanner }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:description" content="{{ metadata.assets.desc }}">
<meta name="twitter:image" content="{{ metadata.assets.linkbanner }}">
<meta name="og:site_name" content="The Wondrous Web-Surfer!">

<meta property="og:type" content="website">
<meta property="og:url" content="{{ metadata.assets.desc }}">
<meta property="og:image" content="{{ metadata.assets.linkbanner }}">
<meta property="og:title" content="{{ title | default('The Wondrous Web-Surfer!') }}">
<meta property="twitter:domain" content="web-surfer.neocities.org">

<meta name="theme-color" content="#ba3939">
<meta name="robots" content="index, nofollow">
<meta name="robots" content="noai, noimageai">
<meta name="pinterest" content="nopin">


{% if '/index' in page.url %}
<link rel="canonical" href="https://web-surfer.neocities.org/index">

<!-- You gotta work on this shit dude.
<link rel="alternate" href="/feed/feed.txt" type="text/plain" title="TWWS RSS">
-->
{% endif %}

</head>


<noscript>
<div class="center">

Hey, sorry, but this site probably looks wonky because <strong><em>you don't seem to have JavaScript enabled</em></strong>, which is required to see the navigation menu (and a table of contents). You should utilize the <a href="/sitemap" style="color: #8ccfff;">Sitemap</a> to get around if you decide to leave JS disabled. :)

</div>
</noscript>

<body>
    <header-component></header-component>
  
<header id="header" style="background-image: url(/assets/bgs/{{ bgimage }})" alt="A repeating pattern"></header>
      <main>

<div id="container"><main>
  <h1>Yayyy {{ title }} Zone!</h1>

{% if (pagedoll) %}
  <div class="pagedoll">
  <a href="#"><img src="/assets/decor/{{ pagedoll }}.png" alt="Back to Top pagedoll" title="Back to Top"></a>
  </div>
  {% endif %}

  {% if (drama) %}

  <div class="centerDivider">
  <img src="/assets/dividers/mushrooms.png" alt="A colorful mushroom divider" aria-hidden="true">
  </div>
 
  <blockquote><em>{{ drama }}</em></blockquote>

    {%- else -%}

    <div class="centerDivider">
    <img src="/assets/dividers/mushrooms.png" alt="A colorful mushroom divider" aria-hidden="true">
    </div>

  {% endif %}

  {% if (pagedoll2) %}
  <img src="/assets/decor/{{ pagedoll2 }}.png" div class="pagedollbreaker" alt="Pagedoll">
  {% endif %}

<div id="toc" role="list"></div>

<div id="contents">
  {{ content | safe }}

</main>
</div>
</main>

<footer id="footer">

<div class="footercenter">
<img src="/assets/decor/spipool1.gif" style="margin-top: 20px;" alt="A pixel art GIF of an angry Spider-Man saying, 'I hate you!' while facing Deadpool." aria-hidden="true"> <img src="/assets/decor/spipool2.gif" style="margin-top: 20px;" alt="A pixel art GIF of Deadpool saying, 'You love me!' while facing Spider-Man." aria-hidden="true">
<p><a href="#">Back to Top</a> // <a href="https://dynaknights.atabook.org">Guestbook</a></p>
<p><small>✦︎ Copyright 2024 - 2999 ✦︎</small></p>
</div>
</footer>
</body>
</html>

   {% include 'toc.njk' %}