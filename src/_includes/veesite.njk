<!DOCTYPE html>
<html class="no-js" lang="{{ metadata.language }}">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Proxymoron.web</title>
<link rel="stylesheet" href="{{ metadata.assets.css }}/veesite.css">
<meta name="description" content="{{ metadata.assets.desc }}">
<link rel="icon" href="{{ metadata.assets.favicon }}" sizes="any">
<script src="{{ metadata.assets.js }}/nav.js" type="text/javascript" defer></script>
<script src="https://u.widget.st/ar.js"></script>

<meta name="author" content="{{ metadata.assets.author }}">
