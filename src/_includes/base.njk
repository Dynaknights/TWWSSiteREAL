{% include "header.njk" %}

<body>
    <header-component></header-component>
  
<header id="header" style="background-image: url(/assets/bgs/{{ bgimage }})"></header>
      <main>

<div id="container"><main>
    <h1><img src="/assets/decor/wing1.gif"> {{ title +"!" }} <img src="/assets/decor/wing2.gif"></h1>

{% if (pagedoll) %}
  <div class="pagedoll">
  <img src="/assets/decor/{{ pagedoll }}">
  </div>
  {% endif %}

  {% if (drama) %}

  <div class="centerDivider">
  <img src="/assets/dividers/divider31.png" style="height:100%; width:100%; margin-top:20px;">
  </div>
 
  <blockquote><strong><em>{{ drama }}</em></strong></blockquote>

    {%- else -%}

    <div class="centerDivider">
      <img src="/assets/dividers/divider31.png" style="height:100%; width:100%; margin-top:20px;">
    </div>

  {% endif %}

  {% if (pagedoll2) %}
  <img src="/assets/decor/{{ pagedoll2 }}" div class="pagedollbreaker">
  {% endif %}

  {% if (cover) %}
  <div class="coverhere" style="background-image: url('/assets/gallery/covers/{{ cover }}')"></div>
  {% endif %}

  {{ content | safe }}

</main>
</div>
</main>

