<body>
    <header-component></header-component>
  
<header id="header" style="background-image: url(/assets/bgs/{{ bgimage }})" alt="A repeating pattern"></header>
      <main>

<div id="container"><main>
  <h1 style="border-bottom: 0px;">{{ title +"!" }}</h1>
{% if (subtitle) %}
 <h2 div class="center">{{ subtitle }}</h2>
{% endif %}

{% if (pagedoll) %}
  <div class="pagedoll">
  <a href="#"><img src="/assets/decor/{{ pagedoll }}.png" alt="Back to Top pagedoll" title="Back to Top"></a>
  </div>
  {% endif %}

  {% if (drama) %}

  <div class="centerDivider">
  <img src="/assets/dividers/divider31.png" style="height:100%; width:100%; margin-top:20px;" alt="Divider" aria-hidden="true">
  </div>
 
  <blockquote><em>{{ drama }}</em></blockquote>

    {%- else -%}

    <div class="centerDivider">
      <img src="/assets/dividers/divider31.png" style="height:100%; width:100%; margin-top:20px;" alt="Divider" aria-hidden="true">
    </div>

  {% endif %}

  {% if (pagedoll2) %}
  <img src="/assets/decor/{{ pagedoll2 }}.png" div class="pagedollbreaker" alt="Pagedoll">
  {% endif %}

  {% if (cover) %}
  <div class="coverhere" style="background-image: url('/assets/gallery/{{ cover }}.png')" alt="A fake TWWS comic book inspired cover."></div>
  {% endif %}

  {{ content | safe }}

</main>
</div>
</main>

  {% include 'footer.njk' %}

